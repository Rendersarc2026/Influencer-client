# Backend API
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Branding — the single source of truth for every brand-facing value.
# Changing these and rebuilding updates the sidebar, login and onboarding
# screens, the browser tab title and the favicon. See src/config/branding.ts.
# ---------------------------------------------------------------------------

# Product name, shown wherever the app names itself.
VITE_APP_NAME=Fetch

# Short line after the name in the tab title. Set it empty for a name-only title.
VITE_APP_TAGLINE=Influencer Marketing Platform

# Optional: overrides the composed "<name> | <tagline>" tab title outright.
# VITE_APP_TITLE=

# Optional: <meta name="description">. Defaults to the tagline.
# VITE_APP_DESCRIPTION=

# Logo and favicon. Either a file in public/ (referenced from the site root,
# e.g. /fetch-logo.jpeg) or an absolute URL.
VITE_APP_LOGO_URL=/fetch-logo.jpeg
VITE_APP_FAVICON_URL=/favicon.png
